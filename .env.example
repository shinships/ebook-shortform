# =============================================================================
# ebook-shortform Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# LLM Backend API Keys (Gemini API key chính, Vertex AI backup)
# Bạn có thể thêm nhiều key cách nhau bằng dấu phẩy (,) để tránh hết quota
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""

# DeepSeek & OpenAI API Keys (Dự phòng / Thay thế cho Gemini)
DEEPSEEK_API_KEY="sk-your_deepseek_api_key_here"
OPENAI_API_KEY="sk-your_openai_api_key_here"

# Telegram Bot Integration (Gửi file EPUB tự động tới nhóm / topic Telegram)
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="-100xxxxxxxxxx"
# Topic / Thread ID trong Forum Group (để trống nếu gửi vào chat thường)
TELEGRAM_TOPIC_ID="365"

# Text-to-Speech (TTS) Configuration for Audiobooks & Podcasts
# Engine lựa chọn: "zerotts" (mặc định, CPU real-time 48kHz, WER 1%), "vieneu" (on-device AI 48kHz) hoặc "vbee" (Cloud API)
TTS_ENGINE="zerotts"

# ZeroTTS Settings (Chạy trực tiếp trên CPU, siêu nhẹ, âm thanh 48kHz, xử lý song ngữ)
# Các giọng có sẵn: "maichi" (Mai Chi - Nữ trẻ nhẹ nhàng, Mặc định), "baotrang" (Bảo Trang - Nữ tin tức rõ ràng),
# "kimoanh" (Kim Oanh - Nữ trung niên ấm áp), "hamy" (Hà My - Nữ cao biểu cảm),
# "giahuy" (Gia Huy - Nam trầm ấm kể chuyện), "huuduc" (Hữu Đức - Nam lớn tuổi điềm đạm),
# "quangminh" (Quang Minh - Nam tin tức dứt khoát), "tiendat" (Tiến Đạt - Nam sôi nổi năng lượng)
ZEROTTS_VOICE="maichi"

# VieNeu-TTS Settings (Chạy cục bộ 48kHz, voice cloning)
# Các giọng có sẵn: "Minh Quân" (mặc định), "Thái Sơn" (kể chuyện Nam), "Anh Khôi" (kể chuyện Bắc),
# "Quỳnh Anh" (đọc truyện), "Ngọc Huyền" (tự nhiên), "Thục Đoan" (kể chuyện Nam), "Quang Sơn" (miền Trung)
VIENEU_VOICE="Minh Quân"
# (Tùy chọn) Đường dẫn file audio mẫu (3-8 giây) nếu muốn clone giọng riêng làm Host
# VIENEU_REF_AUDIO="covers/host_sample.wav"

# Vbee AIVoice TTS API (Dự phòng khi muốn dùng Vbee Cloud API)
VBEE_APP_ID="your_vbee_app_id"
VBEE_APP_NAME="ebook-short"
VBEE_TOKEN="your_vbee_jwt_token"
VBEE_VOICE="hn_female_maiphuong_vdts_48k-fhg"
