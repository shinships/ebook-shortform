# =============================================================================
# ebook-shortform Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# LLM Backend API Keys (Gemini API key chính, Vertex AI backup)
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""

# Telegram Bot Integration (Gửi file EPUB tự động tới nhóm / topic Telegram)
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="-100xxxxxxxxxx"
# Topic / Thread ID trong Forum Group (để trống nếu gửi vào chat thường)
TELEGRAM_TOPIC_ID="365"

# Vbee AIVoice TTS API (Tạo Audio Podcast tóm tắt sách tiếng Việt)
VBEE_APP_ID="your_vbee_app_id"
VBEE_APP_NAME="ebook-short"
VBEE_TOKEN="your_vbee_jwt_token"
# Giọng đọc mặc định (Mặc định: hn_female_maiphuong_vdts_48k-fhg - Mai Phương)
VBEE_VOICE="hn_female_maiphuong_vdts_48k-fhg"
