<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mktmda.ebook-shortform</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mktmda/Projects/ebook-shortform/auto-pipeline.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mktmda/Projects/ebook-shortform</string>

    <!-- Chạy lúc 12:10 mỗi ngày -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <!-- Nhật ký xuất ra logs/ -->
    <key>StandardOutPath</key>
    <string>/Users/mktmda/Projects/ebook-shortform/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mktmda/Projects/ebook-shortform/logs/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
